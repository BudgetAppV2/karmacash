{
    "name": "karmacash-bible-access-module",
    "version": "1.0.0",
    "description": "Bible Access Module for CK_Priming_v11 - Autonomous KarmaCash documentation access with Firebase integration",
    "main": "modules/bible-access/bible-access-module.js",
    "type": "module",
    "scripts": {
      "start": "node modules/bible-access/ck-integration-layer.js",
      "test": "node modules/bible-access/tests/bible-module-tests.js",
      "test:unit": "node modules/bible-access/tests/bible-module-tests.js --unit",
      "test:integration": "node modules/bible-access/tests/bible-module-tests.js --integration", 
      "test:performance": "node modules/bible-access/tests/bible-module-tests.js --performance",
      "test:e2e": "node modules/bible-access/tests/bible-module-tests.js --e2e",
      "setup": "npm run setup:firebase && npm run setup:mcp",
      "setup:firebase": "firebase login && firebase use karmacash-6e8f5",
      "setup:mcp": "npm run setup:mcp:community",
      "setup:mcp:community": "npm install -g @gannonh/firebase-mcp",
      "setup:mcp:official": "npm install -g firebase-tools",
      "build": "echo 'No build step required for this module'",
      "lint": "eslint modules/bible-access/**/*.js",
      "lint:fix": "eslint modules/bible-access/**/*.js --fix",
      "docs": "node scripts/generate-docs.js",
      "health-check": "node scripts/health-check.js",
      "performance-report": "node scripts/performance-report.js"
    },
    "keywords": [
      "firebase",
      "mcp",
      "bible-access",
      "documentation",
      "ai",
      "automation",
      "karmacash",
      "pwa"
    ],
    "author": {
      "name": "KarmaCash Development Team",
      "email": "dev@karmacash.app"
    },
    "license": "MIT",
    "repository": {
      "type": "git",
      "url": "https://github.com/karmacash/bible-access-module.git"
    },
    "bugs": {
      "url": "https://github.com/karmacash/bible-access-module/issues"
    },
    "homepage": "https://github.com/karmacash/bible-access-module#readme",
    "engines": {
      "node": ">=18.0.0",
      "npm": ">=9.0.0"
    },
    "dependencies": {
      "firebase-admin": "^12.0.0",
      "dotenv": "^16.4.0"
    },
    "devDependencies": {
      "eslint": "^8.57.0",
      "jest": "^29.7.0",
      "nodemon": "^3.0.3"
    },
    "peerDependencies": {
      "@gannonh/firebase-mcp": "^1.0.0"
    },
    "optionalDependencies": {
      "firebase-tools": "^13.0.0"
    },
    "config": {
      "mcp": {
        "preferredServer": "community",
        "fallbackServer": "official"
      },
      "firebase": {
        "project": "karmacash-6e8f5",
        "region": "us-central1"
      }
    },
    "mcpServers": {
      "firebase-mcp-community": {
        "command": "npx",
        "args": [
          "-y",
          "@gannonh/firebase-mcp"
        ],
        "env": {
          "SERVICE_ACCOUNT_KEY_PATH": "${SERVICE_ACCOUNT_KEY_PATH}",
          "FIREBASE_STORAGE_BUCKET": "karmacash-6e8f5.firebasestorage.app",
          "DEBUG_LOG_FILE": "./logs/firebase-mcp-debug.log"
        }
      },
      "firebase-mcp-official": {
        "command": "firebase",
        "args": [
          "mcp-server",
          "--dir",
          ".",
          "--only",
          "firestore,storage"
        ],
        "env": {
          "FIREBASE_PROJECT": "karmacash-6e8f5"
        }
      }
    },
    "jest": {
      "testEnvironment": "node",
      "testMatch": [
        "**/tests/**/*.test.js",
        "**/tests/**/*.spec.js"
      ],
      "collectCoverage": true,
      "coverageDirectory": "coverage",
      "coverageReporters": [
        "text",
        "lcov",
        "html"
      ]
    },
    "eslint": {
      "env": {
        "node": true,
        "es2022": true
      },
      "extends": [
        "eslint:recommended"
      ],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "rules": {
        "no-console": "off",
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_"
          }
        ]
      }
    }
  }